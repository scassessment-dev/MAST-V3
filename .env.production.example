# Set these in Coolify protected RUNTIME variables. Never enter real secrets here.
DATABASE_URL="mysql://mast_v3_prod_app:<url-encoded-password>@192.168.40.10:3306/mast_v3_prod"
DATABASE_CONNECTION_LIMIT="10"
AUTH_SECRET="<new-long-random-production-secret>"
TZ="Asia/Kolkata"
# Admin resource only: final HTTPS address of the participant resource.
PARTICIPANT_URL="https://<participant-domain>"
# Enable only when DB01 has a configured trusted TLS certificate.
DATABASE_SSL="false"
# DATABASE_SSL_CA_PATH="/run/secrets/mariadb-ca.pem"
